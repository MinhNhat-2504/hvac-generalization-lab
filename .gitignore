# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# OS / editor
.DS_Store
.vscode/
.idea/
.obsidian/

# Notebooks
.ipynb_checkpoints/

# Evaluation outputs.
#
# A full sweep is a few hundred MB per policy, almost all of it charts and
# per-step time series. None of it is tracked: a results tree is reproducible
# by re-running evaluate.py, and keeping one in the repo would make the clone
# large for no benefit.
#
# If you want to keep a sweep, keep reward_components.csv. Cost and carbon are
# deterministic functions of the timestamp and linear in the energy rate, so
# that one file lets a different normalisation be scored without re-simulating
# anything.
results/
smart_buildings/results/

# Holdout data must never enter this repo. These rules are a backstop in case a
# generator is ever pointed at the default output path.
smart_buildings/test_buildings/
smart_buildings/test_scenarios/
**/holdout*/
**/test_set*/

# ---------------------------------------------------------------------------
# Added for this entry.
# ---------------------------------------------------------------------------

# Generated scenarios. `run_scenario_generator.py` with no arguments rebuilds
# the 30 shipped pairs from training_set.yaml, and the floor_plan.npy /
# zone_map.npy rasters in each are 1.6 MB apiece -- about 100 MB over the set,
# none of it authored here. The configs are regenerable, so they stay out.
smart_buildings/training_scenarios/

# Sweep outputs. The JSON summaries under experiments/runs/ ARE tracked, since
# they are the measurement record; raw per-step traces are not.
experiments/traces/
*.npz

# Generated holdout building definitions. The six shipped building_train_*.yaml
# are tracked; anything else in this directory came out of the floor generator
# for a holdout split and is reproducible from its seed with
# `python -m hvaclab.holdout`. Keeping them out means the repo cannot quietly
# become a place where holdout material is tuned against.
smart_buildings/buildings/*.yaml
!smart_buildings/buildings/building_train_*.yaml

# Generated submission bundle. Rebuild with
# `python -m hvaclab.submission.build --verify`; the sources it assembles from
# are tracked, the assembly is not.
experiments/submission/

# Reproducible worker descriptors and machine-local runtime state. Completed
# scenario records, aggregate scores and frozen protocols remain tracked.
experiments/runs/**/*.log
experiments/runs/**/*.tmp
experiments/runs/**/jobs/*.job.json
experiments/runs/**/paper_build/
experiments/runs/**/scheduler.lock
experiments/runs/**/notification_watcher.json
experiments/runs/**/completion_notice.json
experiments/runs/**/retired_notification_helpers.json
experiments/runs/**/attempts.jsonl
experiments/runs/**/supervisor.lock
experiments/runs/**/supervisor.stop
experiments/runs/**/supervisor_status.json
experiments/runs/**/supervisor_events.jsonl

# Publish active-study protocol only; add its measurement records on completion.
experiments/runs/gated_reheat_calibration/*
!experiments/runs/gated_reheat_calibration/protocol.json

# Filesystem fixtures from local tests, including inaccessible empty temp dirs.
tests/tmp*/
tests/coverage_test_*/
